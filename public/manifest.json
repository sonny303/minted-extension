{
  "manifest_version": 3,
  "name": "Minted Panel Workbench",
  "version": "0.1.0",
  "description": "One-click payer portal form fill from Minted Panel provider data.",
  "action": {
    "default_title": "Minted Panel Workbench",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "scripting"
  ],
  "externally_connectable": {
    "matches": [
      "https://mintedpanel.vercel.app/*"
    ]
  },
  "host_permissions": [
    "https://mintedpanel.vercel.app/*",
    "https://fkvuhfsqcmujywzgczmc.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
