{
  "name": "minted-panel-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Minted Panel Chrome extension — one-click payer portal form fill from provider data via the Minted Panel API.",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:staging": "node scripts/release/build.mjs --target staging",
    "build:production": "node scripts/release/build.mjs --target production",
    "check:store": "node scripts/release/check-store.mjs",
    "test:release": "vitest run scripts/release/contract.test.mjs scripts/release/build.test.mjs src/shared/config.test.ts src/shared/releaseConfig.test.ts src/shared/handoff.test.ts",
    "watch": "node scripts/watch.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/jsdom": "^30.0.0",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
